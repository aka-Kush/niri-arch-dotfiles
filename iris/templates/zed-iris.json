{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Iris",
  "author": "Iris",
  "themes": [
    {
      "name": "Iris Dark",
      "appearance": "dark",
      "style": {
        "accents": ["{accent}", "{green}", "{yellow}"],
        "background.appearance": "opaque",
        "border": "{surface}",
        "border.variant": "{dim}",
        "border.focused": "{accent}",
        "border.selected": "{accent}",
        "border.transparent": "{surface}40",
        "border.disabled": "{surface}60",
        "elevated_surface.background": "{surface}",
        "surface.background": "{bg}",
        "background": "{bg}",
        "element.background": "{surface}",
        "element.hover": "{surface}",
        "element.active": "{dim}",
        "element.selected": "{surface}",
        "element.disabled": "{surface}60",
        "drop_target.background": "{accent}40",
        "ghost_element.background": null,
        "ghost_element.hover": "{surface}80",
        "ghost_element.active": "{surface}",
        "ghost_element.selected": "{accent}30",
        "ghost_element.disabled": "{surface}60",
        "text": "{fg}",
        "text.muted": "{dim}",
        "text.placeholder": "{dim}99",
        "text.disabled": "{fg}60",
        "text.accent": "{accent}",
        "icon": "{fg}",
        "icon.muted": "{dim}",
        "icon.disabled": "{fg}60",
        "icon.placeholder": "{dim}80",
        "icon.accent": "{accent}",
        "status_bar.background": "{bg}",
        "title_bar.background": "{bg}",
        "title_bar.inactive_background": "{surface}",
        "toolbar.background": "{surface}",
        "tab_bar.background": "{surface}",
        "tab.inactive_background": "{bg}",
        "tab.active_background": "{surface}",
        "search.match_background": "{yellow}40",
        "panel.background": "{bg}",
        "panel.focused_border": "{accent}",
        "pane.focused_border": "{accent}",
        "scrollbar.thumb.background": "{dim}80",
        "scrollbar.thumb.hover_background": "{dim}c0",
        "scrollbar.thumb.border": "{surface}40",
        "scrollbar.track.background": "{surface}",
        "scrollbar.track.border": "{surface}20",
        "editor.foreground": "{fg}",
        "editor.background": "{bg}",
        "editor.gutter.background": "{bg}",
        "editor.subheader.background": "{surface}",
        "editor.indent_guide": "{surface}",
        "editor.indent_guide_active": "{dim}",
        "editor.active_line.background": "{surface}80",
        "editor.highlighted_line.background": "{surface}60",
        "editor.line_number": "{dim}",
        "editor.active_line_number": "{accent}",
        "editor.invisible": "{surface}",
        "editor.wrap_guide": "{surface}80",
        "editor.active_wrap_guide": "{dim}80",
        "editor.document_highlight.read_background": "{accent}30",
        "editor.document_highlight.write_background": "{green}30",
        "terminal.background": "{bg}",
        "terminal.foreground": "{fg}",
        "terminal.bright_foreground": "{fg}",
        "terminal.dim_foreground": "{dim}",
        "terminal.ansi.black": "{color0}",
        "terminal.ansi.red": "{color1}",
        "terminal.ansi.green": "{color2}",
        "terminal.ansi.yellow": "{color3}",
        "terminal.ansi.blue": "{color4}",
        "terminal.ansi.magenta": "{color5}",
        "terminal.ansi.cyan": "{color6}",
        "terminal.ansi.white": "{color7}",
        "terminal.ansi.bright_black": "{color8}",
        "terminal.ansi.bright_red": "{color9}",
        "terminal.ansi.bright_green": "{color10}",
        "terminal.ansi.bright_yellow": "{color11}",
        "terminal.ansi.bright_blue": "{color12}",
        "terminal.ansi.bright_magenta": "{color13}",
        "terminal.ansi.bright_cyan": "{color14}",
        "terminal.ansi.bright_white": "{color15}",
        "terminal.ansi.dim_black": "{color0}",
        "terminal.ansi.dim_red": "{red}",
        "terminal.ansi.dim_green": "{green}",
        "terminal.ansi.dim_yellow": "{yellow}",
        "terminal.ansi.dim_blue": "{accent}",
        "terminal.ansi.dim_magenta": "{syntax_keyword}",
        "terminal.ansi.dim_cyan": "{syntax_func}",
        "terminal.ansi.dim_white": "{dim}",
        "link_text.hover": "{accent}",
        "conflict": "{red}",
        "conflict.background": "{red}30",
        "conflict.border": "{red}",
        "created": "{green}",
        "created.background": "{green}30",
        "created.border": "{green}",
        "deleted": "{red}",
        "deleted.background": "{red}30",
        "deleted.border": "{red}",
        "error": "{red}",
        "error.background": "{red}30",
        "error.border": "{red}",
        "hidden": "{dim}",
        "hidden.border": "{surface}",
        "hint": "{accent}",
        "hint.background": "{accent}30",
        "hint.border": "{accent}",
        "ignored": "{dim}80",
        "ignored.background": "{surface}40",
        "ignored.border": "{surface}",
        "info": "{accent}",
        "info.background": "{accent}30",
        "info.border": "{accent}",
        "modified": "{yellow}",
        "modified.background": "{yellow}30",
        "modified.border": "{yellow}",
        "predictive": "{dim}80",
        "predictive.border": "{dim}",
        "predictive.background": "{surface}80",
        "renamed": "{green}",
        "renamed.border": "{green}",
        "renamed.background": "{green}30",
        "success": "{green}",
        "success.background": "{green}30",
        "success.border": "{green}",
        "unreachable": "{dim}80",
        "unreachable.background": "{surface}40",
        "unreachable.border": "{surface}",
        "warning": "{yellow}",
        "warning.background": "{yellow}30",
        "warning.border": "{yellow}",
        "players": [
          {"cursor": "{accent}", "background": "{accent}30", "selection": "{accent}20"},
          {"cursor": "{green}", "background": "{green}30", "selection": "{green}20"}
        ],
        "syntax": {
          "boolean": {"color": "{syntax_const}", "font_style": null, "font_weight": null},
          "comment": {"color": "{syntax_comment}", "font_style": "italic", "font_weight": null},
          "comment.doc": {"color": "{syntax_comment}", "font_style": "italic", "font_weight": null},
          "constant": {"color": "{syntax_const}", "font_style": null, "font_weight": null},
          "constructor": {"color": "{syntax_type}", "font_style": null, "font_weight": null},
          "emphasis": {"color": "{accent}", "font_style": "italic", "font_weight": null},
          "emphasis.strong": {"color": "{accent}", "font_style": null, "font_weight": 700},
          "function": {"color": "{syntax_func}", "font_style": null, "font_weight": null},
          "keyword": {"color": "{syntax_keyword}", "font_style": null, "font_weight": null},
          "number": {"color": "{syntax_const}", "font_style": null, "font_weight": null},
          "operator": {"color": "{syntax_operator}", "font_style": null, "font_weight": null},
          "property": {"color": "{syntax_param}", "font_style": null, "font_weight": null},
          "punctuation": {"color": "{dim}", "font_style": null, "font_weight": null},
          "punctuation.bracket": {"color": "{dim}", "font_style": null, "font_weight": null},
          "punctuation.delimiter": {"color": "{dim}", "font_style": null, "font_weight": null},
          "punctuation.list_marker": {"color": "{dim}", "font_style": null, "font_weight": null},
          "punctuation.special": {"color": "{syntax_operator}", "font_style": null, "font_weight": null},
          "string": {"color": "{syntax_string}", "font_style": null, "font_weight": null},
          "string.escape": {"color": "{syntax_operator}", "font_style": null, "font_weight": null},
          "string.regex": {"color": "{yellow}", "font_style": null, "font_weight": null},
          "string.special": {"color": "{green}", "font_style": null, "font_weight": null},
          "string.special.symbol": {"color": "{syntax_string}", "font_style": null, "font_weight": null},
          "tag": {"color": "{syntax_keyword}", "font_style": null, "font_weight": null},
          "text.literal": {"color": "{syntax_string}", "font_style": null, "font_weight": null},
          "type": {"color": "{syntax_type}", "font_style": null, "font_weight": null},
          "variable": {"color": "{fg}", "font_style": null, "font_weight": null},
          "variable.special": {"color": "{syntax_param}", "font_style": null, "font_weight": null}
        }
      }
    }
  ]
}
