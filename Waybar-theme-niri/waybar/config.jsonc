{
    "layer": "top", 
    "position": "top", 
    "height": 30, 
    "spacing": 4, 
    "modules-left": [
        "niri/workspaces",
        "mpris"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "tray",
        "custom/sep",
        "cpu",
        "memory",
        "custom/sep",
        "network",
        "custom/sep",
        "backlight",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "battery",
        "custom/sep",
        "clock"
    ],
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
    },
    "clock": {
        "format": "{:%I:%M:%S}",
        "interval": 1,
        "tooltip-format": "{calendar}",
        "calendar": {
            "format": {
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "cpu {usage}%",
        "tooltip": false,
        "on-click": "missioncenter"
    },
    "memory": {
        "format": "mem {}%",
        "on-click": "missioncenter"
    },
    "backlight": {
        "tooltip-format": "Click to toggle night mode",
        "device": "amdgpu_bl1",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "format": "brt {percent}%",
        "on-click": "~/.config/niri/nightmode.sh"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "notify-send -u normal 'Low Battery'",
            "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
        },
        "format": "bat {capacity}%",
        "format-full": "bat {capacity}%",
        "format-charging": "bat {capacity}%",
        "format-plugged": "bat {capacity}%",
        "format-alt": "bat {time}"
    },
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "kitty nmtui"
    },
    "pulseaudio": {
        "on-scroll-up": "wpctl set-volume --limit 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume --limit 1.5 @DEFAULT_AUDIO_SINK@ 5%-",
        "max-volume": 150,
        "format": "vol {volume}%",
        "format-bluetooth": "vol {volume}%",
        "format-bluetooth-muted": "vol {volume}%",
        "format-muted": "vol {volume}%",
        "format-source": "{volume}%",
        "format-source-muted": "{volume}%",
        "on-click": "pavucontrol"
    },
    "mpris": {
        "format": "{status_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "status-icons": {
            "playing": "▶",
            "paused": ""
        },
        "dynamic-order": ["title", "artist", "album"],
        "title-len": 30,
        "dynamic-len": 50
    },
    "custom/sep": {
        "format": "|",
        "interval": 3600,
        "tooltip": false
    }
}
